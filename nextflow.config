params {
    help = false
    samplesheet = 'samplesheet.csv'
    counts_sheet = null
    mirna_fa = null
    outdir = './results'
    intermediates = 'checkpoint'
    adaptor_r1 = 'AGATCGGAAGAGCACA'
    adaptor_r2 = 'GATCGTCGGACTGTAGAA'
    cutadapt_opts = '-O 5 -m 17 -e 0.18 --discard-untrimmed'
    pear_min_ovlp = 17
    pear_min_length = 17
    pear_memory = '1G'
    cutadapt_threads = 4
    pear_threads = 4
    compact_threads = 4
    qc_sample_reads = 100000
    count_max_unique = 1000000
    local_cpus = 6
    local_memory = '10 GB'
    local_queue_size = 6
    qc_max_forks = 4
    count_max_forks = 2
    preprocess_max_forks = 2
    cutadapt_bin = 'cutadapt'
    pear_bin = 'pear'
    perl_bin = 'perl'
    py_bin = 'python3'
    cxx_bin = 'c++'
    execution_reports = false
}
// Local reservations are not OS-enforced limits. Tool workers must fit task.cpus.
executor {
    name = 'local'
    cpus = params.local_cpus
    memory = params.local_memory
    queueSize = params.local_queue_size
}
process {
    cpus = 1
    memory = '1 GB'
    time = '24h'
    cache = 'deep'
    errorStrategy = 'terminate'
    shell = ['/bin/bash','-euo','pipefail']
    withLabel: light { memory = '512 MB' }
    withLabel: audit { maxForks = 2 }
    withLabel: trim { cpus = params.cutadapt_threads; memory = '4 GB'; maxForks = params.preprocess_max_forks }
    withLabel: merge_reads { cpus = params.pear_threads; memory = '4 GB'; maxForks = params.preprocess_max_forks }
    withLabel: qc_scan { memory = '1 GB'; maxForks = params.qc_max_forks }
    withLabel: exact_count { memory = '4 GB'; maxForks = params.count_max_forks }
    withLabel: compact { cpus = params.compact_threads; memory = '4 GB'; maxForks = params.preprocess_max_forks }
}
profiles {
    desktop { params.local_cpus = 6; params.local_memory = '10 GB'; params.local_queue_size = 6 }
    workstation { params.local_cpus = 8; params.local_memory = '12 GB'; params.local_queue_size = 8 }
    test {
        params.local_cpus = 2; params.local_memory = '6 GB'; params.local_queue_size = 4
        params.cutadapt_threads = 1; params.pear_threads = 1; params.compact_threads = 1
        params.qc_max_forks = 2; params.preprocess_max_forks = 1
    }
}

// Enable with --execution_reports; explicit -with-* paths remain supported.
trace {
    enabled = params.execution_reports
    file = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
    fields = 'task_id,hash,name,status,exit,submit,start,complete,duration,realtime,cpus,memory,%cpu,peak_rss,read_bytes,write_bytes,workdir'
}
report {
    enabled = params.execution_reports
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
timeline {
    enabled = params.execution_reports
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
