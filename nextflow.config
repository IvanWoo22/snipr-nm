/*
================================================================================
nextflow.config — SNIPR-Nm 本地运行配置
================================================================================
将本文件放到 pipeline 根目录，Nextflow 会自动读取。
如需调整参数，优先修改本文件，而非 SNIPR-Nm.nf。
================================================================================
*/

// ── 主要参数（可在命令行用 --xxx 覆盖）──────────────────────────────────────
params.samplesheet    = "samplesheet.csv"
params.mirna_fa       = "ath_mirna_neo.fa"
params.outdir         = "./results"

// ── 接头序列（常规 Illumina 小 RNA 文库）──────────────────────────────────
params.adaptor_r1    = "AGATCGGAAGAGCACA"
params.adaptor_r2    = "GATCGTCGGACTGTAGAA"

// ── 线程与性能 ─────────────────────────────────────────────────────────────
params.cutadapt_threads = 8
params.pear_threads     = 4

// ── PEAR 合并参数 ────────────────────────────────────────────────────────────
params.pear_min_ovlp = 17   // PEAR 最小 overlap 长度

// ── 软件路径（确保这些命令在你的 PATH 中或填写完整路径）─────────────────────
// 用 which <命令> 查看路径，填写到对应的 _bin 参数中。
// 也可以在命令行覆盖：--cutadapt_bin /path/to/cutadapt
params.cutadapt_bin = "cutadapt"
params.pear_bin     = "pear"
params.tsvjoin_bin  = "tsv-join"
params.perl_bin     = "perl"
params.py_bin       = "python3"
params.bin_dir      = "${workflow.projectDir}/bin"

// ── Nextflow 运行时选项 ─────────────────────────────────────────────────────
// 缓存已完成的流程结果，断点续跑用 -resume
nextflow.cache.enable = true

// ── 本地执行资源上限（避免把机器跑满）───────────────────────────────────────
process {
    // 默认每个步骤最多使用 8 核、16 GB 内存
    // 具体步骤的资源需求见下方 withName 覆盖
    cpus   = 8
    memory = 16.GB
    time   = 1.h
}

// ── 各步骤具体资源配置 ───────────────────────────────────────────────────────
process {
    withName: CUTADAPT {
        cpus   = params.cutadapt_threads
        memory = 8.GB
        time   = 2.h
    }
    withName: PEAR {
        cpus   = params.pear_threads
        memory = 8.GB
        time   = 4.h
    }
    withName: FASTQ2COUNT {
        memory = 4.GB
        time   = 1.h
    }
    withName: MIRNA_COUNT {
        memory = 4.GB
        time   = 1.h
    }
    withName: ANNOTATE_SAMPLE {
        memory = 1.GB
        time   = 1.h
    }
    withName: MERGE_SAMPLES {
        memory = 8.GB
        time   = 2.h
    }
    withName: QC_SAMPLE {
        cpus   = 4
        memory = 8.GB
        time   = 1.h
    }
    withName: MULTIQC {
        cpus   = 2
        memory = 4.GB
        time   = 10.m
    }
}
