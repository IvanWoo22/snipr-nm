params {
    help = false
    samplesheet = 'samplesheet.csv'
    mirna_fa = null
    outdir = './results'
    adaptor_r1 = 'AGATCGGAAGAGCACA'
    adaptor_r2 = 'GATCGTCGGACTGTAGAA'
    cutadapt_opts = '-O 5 -m 17 -e 0.18 --discard-untrimmed'
    pear_min_ovlp = 17
    pear_min_length = 17
    pear_memory = '1G'
    cutadapt_threads = 4
    pear_threads = 4
    qc_sample_reads = 100000
    local_cpus = 8
    local_memory = '12 GB'
    local_queue_size = 2
    cutadapt_bin = 'cutadapt'
    pear_bin = 'pear'
    perl_bin = 'perl'
    py_bin = 'python3'
}

// Resource reservations throttle local concurrency, not OS-enforced memory limits.
executor {
    name = 'local'
    cpus = params.local_cpus
    memory = params.local_memory
    queueSize = params.local_queue_size
}
process {
    cpus = 1
    memory = '1 GB'
    time = '24h'
    cache = 'deep'
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']
    withName: CUTADAPT { cpus = params.cutadapt_threads; memory = '4 GB' }
    withName: PEAR { cpus = params.pear_threads; memory = '4 GB' }
    withName: FASTQ2COUNT { memory = '4 GB' }
    withName: QC_SAMPLE { memory = '2 GB' }
}
